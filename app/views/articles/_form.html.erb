<%= form_with model: @article,  local: true, html: { multipart: true, id: "article-form"} do |form| %>
<div class="mb-4">
    <button type="button" data-current="sticker" id="sticker-bg-toggle" class="mb-2 btn btn-primary">Backgrounds</i></button>
    <div class="d-flex flex-row gap-2 pb-4" style="height:75vh;">
        <div class="canvas-button-container pb-2 gap-1 overflow-auto d-flex flex-column">
            <div class="d-none flex-column" id="frog-stickers">
                <% Dir.glob("#{Rails.root}/public/frogs/*").each do |image_path| %>
                <% image_file = File.basename(image_path) %>
                <button type="button" class="mb-2 border sticker-button p-2 rounded-1" id="<%= image_file.chomp(File.extname(image_file)) %>-sticker">
                    <img src="/frogs/<%= image_file %>" alt="frogs" width="75" height="75">
                </button>
                <% end %>
            </div>
            <div class="d-flex flex-column" id="background-images">
                <% Dir.glob("#{Rails.root}/public/background-images/*").each do |image_path| %>
                <% image_file = File.basename(image_path) %>
                <button type="button" class="bg-img-button p-2 rounded-1" id="<%= image_file.chomp(File.extname(image_file)) %>-sticker">
                    <img src="/background-images/<%= image_file %>" alt="<%= image_path %>" width="75" height="75">
                </button>
                <% end %>
            </div>
        </div>

        <div data-active="false" data-controller="canvas" id="canvas-container" class="canvas-container" style="width: 100%;">
            <img class="position-absolute mouse-sticker" style="opacity: 0.25; pointer-events: none; " id="mouse-sticker" src="/frogs/frog1.png" alt="egg">
            <canvas class="rounded-1 border" id="fabricCanvas" width="100%" height="100%"></canvas>
        </div>

        <div class="d-flex flex-column justify-content-center align-items-center">
            <button title="Increase sticker size" type="button" id="increase-sticker-size" class="sticker-btn mb-3 btn btn-primary"><i style="font-size: 15px;" class="bi bi-brush"></i></i></button>
            <input type="range" class=" sticker-size" id="sticker-size" min="30" max="400" value="200">
            <button title="Decrease sticker size" type="button" id="decrease-sticker-size" class="sticker-btn mt-3 btn btn-primary"><i style="font-size: 11px;" class="bi bi-brush"></i></i></button>
        </div>
    </div>

    <ul class="d-flex gap-2 mb-4 canvas-image-alt-btns">
        <li>
            <button title="Delete sticker" type="button" id="delete-button" class="sticker-btn mb-4 btn btn-primary"><i class="bi bi-trash3-fill"></i></button>
        </li>
        <li>
            <button title="Move sticker infront" type="button" id="move-forwards" class="sticker-btn mb-4 btn btn-primary"><i class="bi bi-arrow-bar-up"></i></button>
        </li>
        <li>
            <button title="Move sticker behind" type="button" id="move-backwards" class="sticker-btn mb-4 btn btn-primary"><i class="bi bi-arrow-bar-down"></i></button>
        </li>
        <li>
            <button title="Rotate sticker counterclockwise" type="button" id="rotate-counterclockwise" class="sticker-btn mb-4 btn btn-primary"><i class="bi bi-arrow-counterclockwise"></i></button>
        </li>
        <li>
            <button title="Rotate sticker clockwise" type="button" id="rotate-clockwise" class="sticker-btn mb-4 btn btn-primary"><i class="bi bi-arrow-clockwise"></i></button>
        </li>
    </ul>
</div>

<!-- other article fields -->
<%= form.hidden_field :image, id: 'article-image' %>

<div class="form mx-auto">
    <div class="mb-4">
        <%= form.label :title, class: 'mb-2'%><br>
        <%= form.text_field :title, class: 'form-control mb-2'%>
        <% @article.errors.full_messages_for(:title).each do |message| %>

        <div class="mb-2"><%= message %></div>
        <% end %>
    </div>

    <div class="mb-4">
        <%= form.label :body , class: 'mb-2'%>
        <%= form.text_area :body, size: "70x5", class: 'form-control mb-2'%>
        <% @article.errors.full_messages_for(:body).each do |message| %>

        <div class="ms-1 text-danger"><%= message %></div>
        <% end %>
    </div>

    <div class="mb-4">
        <%= form.label :tags , "Tags (comma separated)", class: 'mb-2'%>
        <%= form.text_field :tag_list, value: @article.tag_list, class: "form-control" %>
    </div>

    <div class="mb-5">
        <%= form.label :status , class: 'mb-2'%><br>
        <%= form.select :status, Visible::VALID_STATUSES, { selected: article.status || 'public' }, { class: "form-select" } %>
    </div>

    <div>
        <%= form.submit "Finished", class: "btn btn-primary"%>
    </div>

</div>
<% end %>